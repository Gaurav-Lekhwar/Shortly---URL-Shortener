# ---- App ----
NODE_ENV=development
PORT=3000
# Public base URL used to build the short link shown to users (e.g. https://shortly.com)
APP_URL=http://localhost:3000

# ---- PostgreSQL ----
# When running via docker compose the app/worker services override this to point at the postgres service.
DATABASE_URL=postgresql://shortly:shortlysecret@localhost:5432/shortly

# ---- Redis ----
# Used for the URL cache, rate limiting and the BullMQ analytics queue.
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Secret used to sign session cookies. Generate a long random string for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Session lifetime in milliseconds (default 7 days)
SESSION_MAX_AGE_MS=604800000

# ---- Postgres service credentials (used by docker-compose for the DB container) ----
POSTGRES_USER=shortly
POSTGRES_PASSWORD=shortlysecret
POSTGRES_DB=shortly
