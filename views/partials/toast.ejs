<div id="toast" class="fixed bottom-6 right-6 z-50 hidden max-w-sm"></div>
<script>
  // Minimal toast helper used by dashboard JS
  window.toast = function (message, type = 'info') {
    const el = document.getElementById('toast');
    const colors = { info: 'bg-slate-900', success: 'bg-emerald-600', error: 'bg-rose-600' };
    el.className = `fixed bottom-6 right-6 z-50 max-w-sm text-white text-sm px-4 py-3 rounded-lg shadow-lg ${colors[type] || colors.info}`;
    el.textContent = message;
    el.classList.remove('hidden');
    clearTimeout(el._t);
    el._t = setTimeout(() => el.classList.add('hidden'), 4000);
  };
</script>
