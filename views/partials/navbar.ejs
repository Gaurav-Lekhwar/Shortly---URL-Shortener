<nav class="bg-slate-900 text-white">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="<%= user ? '/dashboard' : '/' %>" class="text-xl font-bold tracking-tight">Shortly<span class="text-sky-400">.</span></a>
    <div class="flex items-center gap-4 text-sm">
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="text-slate-300 hidden sm:inline"><%= user.email %></span>
        <a href="/dashboard" class="hover:text-sky-300">Dashboard</a>
        <a href="/api-docs" class="hover:text-sky-300">API docs</a>
        <form action="/api/v1/auth/logout" method="POST" class="inline">
          <button type="submit" class="bg-slate-700 hover:bg-slate-600 px-3 py-1.5 rounded">Log out</button>
        </form>
      <% } else { %>
        <a href="/api-docs" class="hover:text-sky-300">API docs</a>
        <a href="/login" class="hover:text-sky-300">Log in</a>
        <a href="/register" class="bg-sky-500 hover:bg-sky-400 px-3 py-1.5 rounded font-medium">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>
