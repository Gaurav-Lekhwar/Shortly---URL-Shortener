<% const body = `
<div class="max-w-md mx-auto mt-10 bg-white rounded-xl shadow-sm border border-slate-200 p-8">
  <h1 class="text-2xl font-bold mb-1">Create your account</h1>
  <p class="text-slate-500 text-sm mb-6">Start shortening links in seconds.</p>
  ${typeof error !== 'undefined' && error ? `<div class="mb-4 text-sm text-rose-700 bg-rose-50 border border-rose-200 rounded px-3 py-2">${error}</div>` : ''}
  <form action="/api/v1/auth/register" method="POST" class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="email">Email</label>
      <input id="email" name="email" type="email" required class="w-full border border-slate-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="password">Password</label>
      <input id="password" name="password" type="password" required minlength="8" class="w-full border border-slate-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-sky-500" />
      <p class="text-xs text-slate-400 mt-1">At least 8 characters.</p>
    </div>
    <button type="submit" class="w-full bg-sky-600 hover:bg-sky-500 text-white font-medium rounded px-3 py-2">Sign up</button>
  </form>
  <p class="text-sm text-slate-500 mt-4">Already have an account? <a href="/login" class="text-sky-600 hover:underline">Log in</a></p>
</div>
`; %>
<%- include('../layouts/main', { title, body, user: null }) %>
